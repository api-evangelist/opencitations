        {
          "id": "828a2c25-8545-4d1b-833a-68460e3c653b",
          "name": "Get outgoing references",
          "request": {
            "name": "Get outgoing references",
            "description": {
              "content": "Retrieves citation data for all outgoing references to other cited works appearing in the reference list of the bibliographic entity identified by the input PID (DOI, PMID, or OMID).\nFields returned: oci, citing, cited, creation, timespan, journal_sc, author_sc.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "references",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "require",
                  "value": "<string>",
                  "description": "Removes rows with empty values in the specified field"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Applies conditional filtering. Supports regex or operators (=, <, >). Format: field:operator:value. Example: date:>2015\n"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Orders results by field in ascending or descending order. Format: asc(field) or desc(field).\n"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Output format. Accepts \"csv\" or \"json\" (default)."
                },
                {
                  "disabled": false,
                  "key": "json",
                  "value": "<string>",
                  "description": "Transforms JSON data structure. Supports array splitting or dict conversion.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) PID of the bibliographic entity. Must be prefixed with identifier type: doi:, pmid:, or omid:\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
