        {
          "id": "476713d6-282e-4cac-8533-ef3a76703d28",
          "name": "Get incoming citations",
          "request": {
            "name": "Get incoming citations",
            "description": {
              "content": "Retrieves citation data for all references appearing in the reference lists of other citing works to the bibliographic entity identified by the input PID (DOI, PMID, or OMID). These constitute the incoming citations of the identified bibliographic entity.\nFields returned: oci, citing, cited, creation, timespan, journal_sc, author_sc.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "citations",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "require",
                  "value": "<string>",
                  "description": "Removes rows with empty values in the specified field"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Applies conditional filtering. Supports regex or operators (=, <, >). Format: field:operator:value. Example: date:>2015\n"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Orders results by field in ascending or descending order. Format: asc(field) or desc(field).\n"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Output format. Accepts \"csv\" or \"json\" (default)."
                },
                {
                  "disabled": false,
                  "key": "json",
                  "value": "<string>",
                  "description": "Transforms JSON data structure. Supports array splitting or dict conversion.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) PID of the bibliographic entity. Must be prefixed with identifier type: doi:, pmid:, or omid:\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a338a656-8060-43a1-9d88-340196f03a81",
              "name": "Incoming citations",
              "originalRequest": {
                "url": {
                  "path": [
                    "citations",
                    ":id"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "require",
                      "value": "doi"
                    },
                    {
                      "key": "filter",
                      "value": "date:>2015"
                    },
                    {
                      "key": "sort",
                      "value": "desc(date)"
                    },
                    {
                      "key": "format",
                      "value": "json"
                    },
                    {
                      "key": "json",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "id",
                      "description": "(Required) PID of the bibliographic entity. Must be prefixed with identifier type: doi:, pmid:, or omid:\n"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "authorization",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"oci\": \"06101801781-06180334099\",\n    \"citing\": \"omid:br/06101801781 doi:10.7717/peerj-cs.421 pmid:33817056\",\n    \"cited\": \"omid:br/06180334099 doi:10.1108/jd-12-2013-0166\",\n    \"creation\": \"2021-03-10\",\n    \"timespan\": \"P6Y0M1D\",\n    \"journal_sc\": \"true\",\n    \"author_sc\": \"true\"\n  },\n  {\n    \"oci\": \"06101801781-06180334099\",\n    \"citing\": \"omid:br/06101801781 doi:10.7717/peerj-cs.421 pmid:33817056\",\n    \"cited\": \"omid:br/06180334099 doi:10.1108/jd-12-2013-0166\",\n    \"creation\": \"2021-03-10\",\n    \"timespan\": \"P6Y0M1D\",\n    \"journal_sc\": \"true\",\n    \"author_sc\": \"true\"\n  }\n]",
